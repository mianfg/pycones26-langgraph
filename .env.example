# ─── Elige UN proveedor ───────────────────────────────────────────────
# Formato "proveedor:modelo" (el que entiende init_chat_model de LangChain),
# o solo el proveedor para usar el modelo por defecto del taller.
#
#   google_genai  → google_genai:gemini-3.5-flash-lite  RECOMENDADO: clave gratuita en
#                   https://aistudio.google.com/apikey (2 minutos, sin tarjeta).
#                   Los Flash «grandes» (3.8, 3.7, 3.6) solo dan 20 peticiones al día gratis.
#   openai        → openai:gpt-6-luna              de pago (céntimos para el taller)
#   anthropic     → anthropic:claude-haiku-5-5     de pago; sin embeddings: RAG solo con BM25
#   ollama        → ollama:gemma4:e4b-it-q4_K_M    local, sin clave; descarga ~7 GB ANTES del taller
#                   (etiqueta GGUF: la «gemma4:e4b» a secas baja la versión MLX, sin salida estructurada)
#                   Portátil de 8 GB: LLM_MODEL=ollama:qwen3.5:4b-q4_K_M y EMBEDDINGS_MODEL=ollama:embeddinggemma (4 GB)
#   offline       → modo de emergencia sin red ni clave (LLM imitado con reglas)
LLM_MODEL=google_genai

# Embeddings: por defecto, los del mismo proveedor. "none" = solo BM25.
# EMBEDDINGS_MODEL=google_genai:gemini-embedding-001
# EMBEDDINGS_MODEL=ollama:embeddinggemma

# ─── Claves (solo la del proveedor que uses) ─────────────────────────
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Si el ponente ofrece un proxy compatible con OpenAI durante el taller:
# LLM_MODEL=openai:gpt-6-luna
# OPENAI_BASE_URL=http://<ip-del-ponente>:4000/v1
# OPENAI_API_KEY=taller

# ─── Studio (bloques 3 a 6; opcional, recomendado) ─────────────────────
# Studio (https://eu.smith.langchain.com/studio) inicia sesión con una cuenta
# gratuita de LangSmith: Sign up en https://eu.smith.langchain.com (Google, GitHub
# o correo; sin tarjeta). La clave (Settings → API Keys → Create API Key) es
# opcional: sirve para las trazas del notebook 05; sin ella, el notebook 00 avisa.
# Con LANGSMITH_TRACING=false el servidor local no envía nada fuera de tu
# máquina; ponlo a true para ver las trazas en LangSmith.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=taller-pycones26
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Cuenta en la región de EE. UU.: LANGSMITH_ENDPOINT=https://api.smith.langchain.com y Studio en smith.langchain.com

# Alternativa de código abierto para las trazas: Langfuse (nube gratuita o autoalojado).
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
